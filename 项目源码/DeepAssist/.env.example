# DeepAssist uses DeepSeek. ``openai_compatible`` is an optional endpoint
# transport only; it does not change the model used by the project.
LLM_PROVIDER=deepseek
OPENAI_COMPATIBLE_API_KEY=EMPTY
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_CHAT_MODEL=deepseek-chat
LLM_REASONER_MODEL=deepseek-reasoner

ROUTER_MODEL_NAME=
ROUTER_TEMPERATURE=0.0
ROUTER_MIN_CONFIDENCE=0.65
ENABLE_ROUTING_LOG=true

# Local paths. Defaults are relative to the project root when prefixed with ./.
EMBEDDING_MODEL_PATH=./data/models/bge-m3
VECTOR_DB_PATH=./data/indexes/vector_store
KEYWORD_DB_PATH=./data/indexes/keyword_store
CONVERSATION_DB_PATH=./data/application_db/conversations.db
USER_PROFILE_DB_PATH=./data/application_db/user_profiles.db
INGEST_PROGRESS_PATH=./data/application_db/ingest_progress.json
KB_MANIFEST_PATH=./data/application_db/knowledge_base_manifest.json
VECTOR_HEALTH_REPORT_PATH=./data/application_db/vector_index_doctor_report.json
AGENT_SANDBOX_DIR=./workspace/agent_sandbox

# Embedding runtime settings.
EMBEDDING_DEVICE=auto
EMBEDDING_CUDA_VISIBLE_DEVICES=
EMBEDDING_BATCH_SIZE=64

# Local development default: expose read/write/Python tool schemas, while HITL
# blocks high-risk execution until approved.
# Set TOOL_APPROVAL_MODE=disabled only when you intentionally want all enabled
# tools to execute directly for local testing.
ENABLE_DEVELOPMENT_TOOLS=true
ALLOWED_TOOL_CATEGORIES=read_only,write_file,code_exec
TOOL_APPROVAL_MODE=hitl
TOOL_TIMEOUT_SECONDS=30

ENABLE_LLM_REWRITE=true
RAG_LOW_RELEVANCE_THRESHOLD=0.2
RRF_K=60
RETRIEVAL_TOP_K=5
# Elasticsearch is the deployed primary; ResilientKeywordDB mirrors to local
# Whoosh so the same application remains usable in an offline demo.
KEYWORD_BACKEND=elasticsearch
ELASTICSEARCH_HOSTS=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=deepassist-kb
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
MEMORY_BACKEND=sqlite
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=deepassist
MYSQL_PASSWORD=
MYSQL_DATABASE=deepassist
RERANKER_BACKEND=cross_encoder
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=16
MAX_AGENT_STEPS=10
AGENT_RUNTIME_BACKEND=langgraph
LANGGRAPH_CHECKPOINT_BACKEND=sqlite
LANGGRAPH_CHECKPOINT_DB_PATH=./data/application_db/langgraph_checkpoints.db

# Optional remote observability. LocalTraceStore remains active as the local
# queryable sink. Leave disabled for an offline run.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=deepassist
LANGSMITH_ENDPOINT=

# Streamlit UI settings.
DEEPASSIST_API_BASE=http://localhost:8000/api
DEEPASSIST_UI_TIMEOUT=180

# Offline ingestion script settings.
DEEPASSIST_MAX_SAMPLES_PER_FILE=50000
DEEPASSIST_INGEST_BATCH_SIZE=1024
