# 只在本地复制为 .env；不要提交真实值。

# Optional read-only database adapter
GENERAL_DB_HOST=localhost
GENERAL_DB_PORT=5432
GENERAL_DB_USERNAME=readonly_user
GENERAL_DB_PASSWORD=replace_me
GENERAL_DB_DATABASE=example_db
GENERAL_DB_SCHEMA=public
DB_SSL_MODE=prefer

# Optional frontend links (normally blank in the public demo)
FRONTEND_PORTAL_URL=
FRONTEND_CASE_SYSTEM_URL=
FRONTEND_USERNAME=
FRONTEND_PASSWORD=

# Optional OpenAI-compatible provider
LLM_PRIMARY_PROVIDER=openai-compatible
LLM_PRIMARY_MODEL=replace_me
LLM_PRIMARY_API_KEY=replace_me
LLM_PRIMARY_BASE_URL=http://localhost:8000/v1
LLM_PRIMARY_MAX_TOKENS=4096
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MAX_TOKENS=4096
LLM_TEMPERATURE=0

