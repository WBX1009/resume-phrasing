# Local configuration only; no real credentials in source control.
CASE_REPOSITORY=examples/cases
CASE_RUNTIME_DIR=runtime/native-v3
# Set offline explicitly for rule-only demonstrations; clear for real LLM.
CASE_REASONER=offline
CASE_LLM_MODEL=replace_me
CASE_LLM_API_KEY=replace_me
# Optional OpenAI-compatible /v1 endpoint. Never supplied by an API caller.
CASE_LLM_BASE_URL=http://localhost:8001/v1
# Optional path to server-owned JSON matching CaseExecutionConfig.
# CASE_EXECUTION_CONFIG=configs/runtime.example.json

# Optional read-only DbRowSource configuration
GENERAL_DB_HOST=localhost
GENERAL_DB_PORT=5432
GENERAL_DB_USERNAME=readonly_user
GENERAL_DB_PASSWORD=replace_me
GENERAL_DB_DATABASE=example_db
GENERAL_DB_SCHEMA=public
DB_SSL_MODE=prefer
